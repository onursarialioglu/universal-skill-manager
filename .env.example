# Optional Environment Variables for Universal Skill Manager (USM)

# GitHub Personal Access Token (used by the GitHub MCP server template)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# USM Custom Home Directory (defaults to ~/.usm)
# USM_HOME=~/.usm

# Default Language ('en' or 'tr')
# USM_LANG=en

# Web UI Port (defaults to 8765)
# USM_PORT=8765
