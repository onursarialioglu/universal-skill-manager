# Auto-detect text files and normalize line endings
* text=auto

# Python, Shell, Markdown, JSON, TOML: LF
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Windows batch files: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.usmpack binary
